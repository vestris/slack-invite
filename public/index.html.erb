<!doctype html>
<html lang="en">
<head>
  <meta name="description" content="Give your Slack community a public join page, with optional admin approval right in Slack.">
  <meta property="og:title" content="Slack Invite Automation">
  <meta property="og:description" content="Give your Slack community a public join page, with optional admin approval right in Slack.">
  <meta property="og:image" content="<%= SlackRubyBotServer::Service.url %><%= h asset_path('/img/icon.png') %>">
  <title>Slack Invite Automation: User Workflow in Slack</title>
  <%= partial 'public/partials/_head.html.erb' %>
</head>
<body class="site-page">
  <%= partial 'public/partials/_navigation.html.erb' %>
  <main id="main">
    <div id="homepage">
      <section class="hero" aria-labelledby="hero-title">
        <div class="page-container">
          <h1 id="hero-title">Make joining easy.</h1>
          <p class="hero-description">Give your Slack community a public join page. Let people request an invitation, with optional admin approval right in Slack.</p>
          <div class="hero-actions">
            <%= partial 'public/partials/_install_button.html.erb' %>
            <a href="#how-it-works">See how it works</a>
          </div>
          <p class="trial-note">Free for two weeks. Then $9.99 per team / year.</p>
          <figure class="hero-preview">
            <img src="<%= h asset_path('/img/screenshot.png') %>" width="1024" height="659" alt="Slack Invite Automation sharing a Slack team's public invitation link">
          </figure>
        </div>
      </section>
      <section class="feature-section" id="how-it-works" aria-labelledby="join-title">
        <div class="page-container feature-layout">
          <div class="feature-copy">
            <h2 id="join-title">Share a Link</h2>
            <p>Share your team's join page. Visitors enter their name and email to receive a Slack invitation.</p>
          </div>
          <figure class="feature-preview">
            <img src="<%= h asset_path('/img/invite.png') %>" width="1600" height="1000" alt="A public invitation page with a Slack team's name, icon, and signup form" loading="lazy">
          </figure>
        </div>
      </section>
      <section class="feature-section" aria-labelledby="approval-title">
        <div class="page-container feature-layout">
          <div class="feature-copy">
            <h2 id="approval-title">Approve in Slack</h2>
            <p>Send <code>set approval on</code> to review join requests by DM. Approve or ignore them right in Slack.</p>
          </div>
          <figure class="feature-preview">
            <img src="<%= h asset_path('/img/approval.png') %>" width="948" height="212" alt="An admin enabling invitation approval in Slack" loading="lazy">
            <img src="<%= h asset_path('/img/join.png') %>" width="982" height="198" alt="A join request sent to a Slack admin for approval" loading="lazy">
          </figure>
        </div>
      </section>
      <section class="pricing-section page-container" id="pricing" aria-label="Pricing">
        <div>
          <p>Try Slack Invite Automation free for two weeks, without a credit card. Then subscribe your Slack team for $9.99 a year, automatically renewed.</p>
          <p><a href="/help.html#support">Questions? Get in touch.</a></p>
        </div>
        <div class="pricing-action">
          <p class="eyebrow">Simple pricing</p>
          <p class="price"><strong>$9.99</strong><span>per team / year</span></p>
          <%= partial 'public/partials/_install_button.html.erb' %>
        </div>
      </section>
    </div>
    <section id="register" class="page-container transaction-page" style="display: none;" aria-labelledby="register-title">
      <h1 id="register-title">Connect your Slack team</h1>
      <p id="messages" role="status" aria-live="polite">Please wait ...</p>
      <p>Having trouble? <a href="/help.html#support">Get help</a> or <a href="/">return to Slack Invite Automation</a>.</p>
    </section>
  </main>
  <%= partial 'public/partials/_footer.html.erb' %>
  <script src="<%= h asset_path('/js/register.js') %>"></script>
</body>
</html>
