<!doctype html>
<html lang="en">

<head>
  <title>Slack Invite Automation: Authorize</title>
  <%= partial 'public/partials/_head.html.erb' %>
  <script src="<%= h asset_path('/js/authorize.js') %>"></script>
  <link rel="shortcut icon" href="<%= h asset_path('/favicon.ico') %>" type="image/x-icon">
  <link rel="icon" href="<%= h asset_path('/favicon.ico') %>" type="image/x-icon">
  <meta name="description" content="User workflow in Slack." />
</head>

<body class="site-page">
  <%= partial 'public/partials/_navigation.html.erb' %>
  <main id="main" class="page-container transaction-page">
    <img class="transaction-logo" src="<%= h asset_path('/img/icon.png') %>" width="88" height="88" alt="">
    <h1>Authorize invitations</h1>
    <p>Connect your admin account so Slack Invite Automation can send invitations on your behalf.</p>
    <p id="messages" role="status" aria-live="polite"></p>
    <p>Use the authorization link supplied by the bot. <a href="/help.html">See the setup guide</a> if you need a hand.</p>
  </main>
  <%= partial 'public/partials/_footer.html.erb' %>
</body>

</html>