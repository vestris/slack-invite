<!doctype html>
<html lang="en">

<head>
  <title>Slack Invite Automation: Get Invited</title>
  <%= partial 'public/partials/_head.html.erb' %>
  <script src="<%= h asset_path('/js/invite.js') %>"></script>
</head>

<body class="site-page">
  <%= partial 'public/partials/_navigation.html.erb' %>
  <main id="main" class="page-container transaction-page">
    <img id="team_icon" class="transaction-logo" src="<%= h asset_path('/img/icon.png') %>" width="88" height="88" alt="Slack team icon">
    <h1 id="team_caption">Get invited to <span id="team_name">your Slack team</span></h1>
    <p><a id="team_href" target="_blank" rel="noopener"></a></p>
    <p id="messages" role="status" aria-live="polite"></p>
    <section id="invite" aria-label="Request an invitation">
    <script>
      $(document).ready(function() {
        <% team = Team.where(team_id: request.params['team_id']).first %>

        var team = {
          id: "<%= team&.team_id %>",
          name: <%= JSON::generate(ERB::Util.html_escape(team&.name)) %>,
          icon: <%= JSON::generate(team&.icon && ERB::Util.html_escape(URI.parse(team&.icon).to_s)) %>,
          workspace_url: <%= JSON::generate(team&.workspace_url && ERB::Util.html_escape(URI.parse(team&.workspace_url).to_s)) %>
        }

        if (! team.name) {
          $('form').remove();
          SlackInvite.message("Missing or invalid team ID.");
          return;
        }

        $('#team_name').html(team.name);

        if (team.workspace_url) {
          $('#team_href').html(team.workspace_url);
          $('#team_href').attr('href', team.workspace_url);
        }
        
        if (team.icon) {
          $('#team_icon').attr('src', team.icon);
        }
      });
      </script>
    <form id="form" class="invite-form" onsubmit="return invite(event);">
      <div>
        <label for="name">Name</label>
        <input type="text" id="name" autocomplete="name">
      </div>
      <div>
        <label for="email">Email</label>
        <input type="email" id="email" autocomplete="email" placeholder="you@example.com">
      </div>
      <button type="submit" class="button" onclick="return invite(event);">Submit</button>
    </form>
    </section>
  </main>
  <%= partial 'public/partials/_footer.html.erb' %>
</body>

</html>